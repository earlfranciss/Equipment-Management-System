<Page x:Class="EQMS.Details.BorrowerDetail.BorrowerDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EQMS.Details.BorrowerDetail"
      mc:Ignorable="d" 
      d:DesignHeight="530" d:DesignWidth="410" 
      Title="BorrowerDetails">


    <Canvas>
        <!-- Details Window -->
        <StackPanel x:Name="Details" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="100" Height="100" >
                <Ellipse Width="100" Height="100" StrokeThickness="1" Stroke="LightGray" Panel.ZIndex="1" />
                <Image x:Name="BorrowerImg" Source="/Resources/Img/userEdit.png" Stretch="Fill">
                    <Image.Clip>
                        <EllipseGeometry RadiusX="50" RadiusY="50" Center="50,50"/>
                    </Image.Clip>
                </Image>
            </Grid>
            <Border x:Name="SetImg" CornerRadius="5" Height="25" Margin="0,10,0,25" Width="80" Background="#0FA9FF" MouseUp="SetImg_MouseUp" MouseEnter="SetImg_MouseEnter" MouseLeave="SetImg_MouseLeave">
                <TextBlock Text="Edit Profile" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
            </Border>
            <!-- ID Number -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="ID Number" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border CornerRadius="10" Background="White" Width="410" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/ID.png" Grid.Column="0" HorizontalAlignment="Left" Width="24" Height="24" Margin="10,0,5,0" />
                        <TextBlock x:Name="IDtxt" Text="ID Number" Style="{StaticResource detailsTxt}"/>
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <StackPanel Margin="0,0,5,0">
                    <!-- First Name -->
                    <TextBlock Text="First Name" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Border CornerRadius="10" Background="White" Width="230" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="/Resources/Img/user.png" Grid.Column="0" HorizontalAlignment="Left" Width="24" Height="24" Margin="10,0,5,0" />
                            <TextBlock x:Name="FNtxt" Text="First Name" Style="{StaticResource detailsTxt}"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                    <!-- Last Name -->
                    <TextBlock Text="Last Name" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Border CornerRadius="10" Background="White" Width="170" Height="35" Padding="5,0,0,0" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LNtxt" Text="Last Name" Style="{StaticResource detailsTxt}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
            <!-- Email Address -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Email" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border CornerRadius="10" Background="White" Width="410" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/email.png" Grid.Column="0" HorizontalAlignment="Left" Width="24" Height="24" Margin="10,0,5,0" />
                        <TextBlock x:Name="Emailtxt" Text="Email Address" Style="{StaticResource detailsTxt}"/>
                    </Grid>
                </Border>
            </StackPanel>
            <!-- Phone Number -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Phone Number" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border CornerRadius="10" Background="White" Width="410" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/phone.png" Grid.Column="0" HorizontalAlignment="Left" Width="24" Height="24" Margin="10,0,5,0" />
                        <TextBlock x:Name="Phonetxt" Text="Phone Number" Style="{StaticResource detailsTxt}"/>
                    </Grid>
                </Border>
            </StackPanel>
            <!-- Role -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Role" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border CornerRadius="10" Background="white" Width="410" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/user.png" Grid.Column="0" HorizontalAlignment="Left" Width="24" Height="24" Margin="10,0,5,0" />
                        <TextBlock x:Name="Roletxt" Text="Role" Style="{StaticResource detailsTxt}"/>
                    </Grid>
                </Border>
            </StackPanel>
            <!-- Edit & Delete Button -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <!-- Edit Button -->
                <Border x:Name="EditBtn" CornerRadius="5" Background="#0FA9FF" Margin="0,0,10,0" MinWidth="60" MouseUp="EditBtn_MouseUp">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/editWhite.png" Grid.Column="0" Width="18" HorizontalAlignment="Center" Margin="5"/>
                        <TextBlock Grid.Column="1" Text="Edit" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Margin="0,0,10,0"/>
                    </Grid>
                </Border>
                <!-- Delete Button -->
                <Border x:Name="DeleteBtn" CornerRadius="5" Background="Red" Margin="0,0,10,0" MinWidth="60" MouseUp="DeleteBtn_MouseUp" MouseEnter="DeleteBtn_MouseEnter" MouseLeave="DeleteBtn_MouseLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/deleteWhite.png" Grid.Column="0" Width="18" HorizontalAlignment="Center" Margin="5"/>
                        <TextBlock Grid.Column="1" Text="Delete" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Margin="0,0,10,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Edit Details -->
        <StackPanel x:Name="EditDetails" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden">
            <Grid Width="100" Height="100" >
                <Ellipse Width="100" Height="100" StrokeThickness="1" Stroke="LightGray" Panel.ZIndex="1" />
                <Image x:Name="EditBorrowerImg" Source="/Resources/Img/userEdit.png" Stretch="Fill">
                    <Image.Clip>
                        <EllipseGeometry RadiusX="50" RadiusY="50" Center="50,50"/>
                    </Image.Clip>
                </Image>
            </Grid>
            <Border x:Name="EditSetImg" CornerRadius="5" Height="25" Margin="0,10,0,20" Width="80" Background="#0FA9FF" MouseUp="SetImg_MouseUp" MouseEnter="EditSetImg_MouseEnter" MouseLeave="EditSetImg_MouseLeave">
                <TextBlock Text="Edit Profile" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
            </Border>
            <!-- ID Number -->
            <StackPanel Margin="0,0,0,10" >
                <TextBlock Text="ID Number" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border CornerRadius="10" Background="White" Width="410" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/ID.png" Grid.Column="0" HorizontalAlignment="Left" Width="24" Height="24" Margin="10,0,5,0" />
                        <TextBlock x:Name="editIDtxt" Text="Enter ID Number" Style="{StaticResource textHint}"/>
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,5,0">
                    <!-- First Name -->
                    <TextBlock Text="First Name" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Border CornerRadius="10" Background="White" Width="230" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="/Resources/Img/user.png" Grid.Column="0" HorizontalAlignment="Left" Width="24" Height="24" Margin="10,0,5,0" />
                            <TextBlock x:Name="editFNtxt" Text="Enter First Name" Style="{StaticResource textHint}"/>
                            <TextBox x:Name="editFNtext" TextChanged="editFNtext_TextChanged" Style="{StaticResource textBox}"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="FNError" Foreground="Red" Margin="40,0,0,0"/>
                </StackPanel>
                <StackPanel Margin="5,0,0,0">
                    <!-- Last Name -->
                    <TextBlock Text="Last Name" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Border CornerRadius="10" Background="White" Width="170" Height="35" Padding="5,0,0,0" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="editLNtxt" Text="Enter Last Name" Style="{StaticResource textHint}"/>
                            <TextBox x:Name="editLNtext" TextChanged="editLNtext_TextChanged" Style="{StaticResource textBox}"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="LNError" Foreground="Red" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <!-- Email Address -->
            <StackPanel>
                <TextBlock Text="Email" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border CornerRadius="10" Background="White" Width="410" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/email.png" Grid.Column="0" HorizontalAlignment="Left" Width="24" Height="24" Margin="10,0,5,0" />
                        <TextBlock x:Name="editEmailtxt" Text="Enter Email Address" Style="{StaticResource textHint}"/>
                        <TextBox x:Name="editEmailtext" TextChanged="editEmailtext_TextChanged" Style="{StaticResource textBox}"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="EmailError" Foreground="Red" Margin="40,0,0,0"/>
            </StackPanel>
            <!-- Phone Number -->
            <StackPanel>
                <TextBlock Text="Phone Number" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border CornerRadius="10" Background="White" Width="410" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/phone.png" Grid.Column="0" HorizontalAlignment="Left" Width="24" Height="24" Margin="10,0,5,0" />
                        <TextBlock x:Name="editPhonetxt" Text="Enter Phone Number" Style="{StaticResource textHint}"/>
                        <TextBox x:Name="editPhonetext" TextChanged="editPhonetext_TextChanged" Style="{StaticResource textBox}"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="PhoneError" Foreground="Red" Margin="40,0,0,0"/>
            </StackPanel>
            <!-- Role -->
            <StackPanel>
                <TextBlock Text="Role" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border CornerRadius="10" Background="white" Width="410" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/user.png" Grid.Column="0" HorizontalAlignment="Left" Width="24" Height="24" Margin="10,0,5,0" />
                        <TextBlock x:Name="editRoletxt" Text="Enter Role" Style="{StaticResource textHint}"/>
                        <TextBox x:Name="editRoletext" TextChanged="editRoletext_TextChanged" Style="{StaticResource textBox}"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="RoleError" Foreground="Red" Margin="40,0,0,0"/>
            </StackPanel>
            <!-- Cancel & Save Button -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Cancel Button -->
                <Border x:Name="Btn" CornerRadius="5" Background="White" Margin="0,0,10,0" MinWidth="60" MouseUp="Btn_MouseUp">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Cancel" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF5B5B5B" Margin="15,5,15,5"/>
                    </Grid>
                </Border>
                <!-- Save Button -->
                <Border x:Name="SaveBtn" CornerRadius="5" Background="#0FA9FF" Margin="0,0,10,0" MinWidth="60" MouseUp="SaveBtn_MouseUp" MouseEnter="SaveBtn_MouseEnter" MouseLeave="SaveBtn_MouseLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/editWhite.png" Grid.Column="0" Width="18" HorizontalAlignment="Center" Margin="5"/>
                        <TextBlock Grid.Column="1" Text="Save" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Margin="0,0,10,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </Canvas>
</Page>
