<Page x:Class="EQMS.Details.EquipmentDetail.EquipmentDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EQMS.Details.EquipmentDetail"
      mc:Ignorable="d" 
      d:DesignHeight="530" d:DesignWidth="410"
      Title="EquipmentDetails">


    <Canvas>
        <!-- Details Window -->
        <StackPanel x:Name="Details" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="100" Height="100" >
                <Ellipse Width="100" Height="100" StrokeThickness="1" Stroke="LightGray" Panel.ZIndex="1" />
                <Image x:Name="EquipmentImg" Source="/Resources/Img/equipmentBlue.png" Stretch="Fill">
                    <Image.Clip>
                        <EllipseGeometry RadiusX="50" RadiusY="50" Center="50,50"/>
                    </Image.Clip>
                </Image>
            </Grid>
            <Border x:Name="SetImg" CornerRadius="5" Height="25" Margin="0,10,0,25" Width="80" Background="#0FA9FF" MouseUp="SetImg_MouseUp" MouseEnter="SetImg_MouseEnter" MouseLeave="SetImg_MouseLeave">
                <TextBlock Text="Edit Profile" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
            </Border>
            <!-- ID Number -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="ID Number" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border CornerRadius="10" Background="White" Width="410" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/ID.png" Grid.Column="0" HorizontalAlignment="Left" Width="22" Height="24" Margin="10,0,5,0" />
                        <TextBlock x:Name="IDtxt" Text="ID Number" Style="{StaticResource detailsTxt}"/>
                    </Grid>
                </Border>
            </StackPanel>
            <!-- Name -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Name" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border CornerRadius="10" Background="White" Width="410" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/equipmentBlue.png" Grid.Column="0" HorizontalAlignment="Left" Width="20" Height="24" Margin="10,0,5,0" />
                        <TextBlock x:Name="Nametxt" Text="Name" Style="{StaticResource detailsTxt}"/>
                    </Grid>
                </Border>
            </StackPanel>
            <!-- Type -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Type" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border CornerRadius="10" Background="White" Width="410" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/typeBlue.png" Grid.Column="0" HorizontalAlignment="Left" Width="22" Height="24" Margin="10,0,5,0" />
                        <TextBlock x:Name="Typetxt" Text="Type" Style="{StaticResource detailsTxt}"/>
                    </Grid>
                </Border>
            </StackPanel>
            <!-- Brand -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Brand" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border CornerRadius="10" Background="White" Width="410" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/brandBlue.png" Grid.Column="0" HorizontalAlignment="Left" Width="24" Height="24" Margin="10,0,5,0" />
                        <TextBlock x:Name="Brandtxt" Text="Brand" Style="{StaticResource detailsTxt}"/>
                    </Grid>
                </Border>
            </StackPanel>
            <!-- Serial Number -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Serial Number" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border CornerRadius="10" Background="White" Width="410" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/serialBlue.png" Grid.Column="0" HorizontalAlignment="Left" Width="24" Height="24" Margin="10,0,5,0" />
                        <TextBlock x:Name="Serialtxt" Text="Serial Number" Style="{StaticResource detailsTxt}"/>
                    </Grid>
                </Border>
            </StackPanel>
            <!-- Edit & Delete Button -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <!-- Edit Button -->
                <Border x:Name="EditBtn" CornerRadius="5" Background="#0FA9FF" Margin="0,0,10,0" MinWidth="60" MouseUp="EditBtn_MouseUp">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/editWhite.png" Grid.Column="0" Width="18" HorizontalAlignment="Center" Margin="5"/>
                        <TextBlock Grid.Column="1" Text="Edit" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Margin="0,0,10,0"/>
                    </Grid>
                </Border>
                <!-- Delete Button -->
                <Border x:Name="DeleteBtn" CornerRadius="5" Background="Red" Margin="0,0,10,0" MinWidth="60" MouseUp="DeleteBtn_MouseUp" MouseEnter="DeleteBtn_MouseEnter" MouseLeave="DeleteBtn_MouseLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/deleteWhite.png" Grid.Column="0" Width="18" HorizontalAlignment="Center" Margin="5"/>
                        <TextBlock Grid.Column="1" Text="Delete" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Margin="0,0,10,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Edit Details -->
        <StackPanel x:Name="EditDetails" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden">
            <Grid Width="100" Height="100" >
                <Ellipse Width="100" Height="100" StrokeThickness="1" Stroke="LightGray" Panel.ZIndex="1" />
                <Image x:Name="EditEquipmentImg" Source="/Resources/Img/equipmentBlue.png" Stretch="Fill">
                    <Image.Clip>
                        <EllipseGeometry RadiusX="50" RadiusY="50" Center="50,50"/>
                    </Image.Clip>
                </Image>
            </Grid>
            <Border x:Name="EditSetImg" CornerRadius="5" Height="25" Margin="0,10,0,20" Width="80" Background="#0FA9FF" MouseUp="SetImg_MouseUp" MouseEnter="EditSetImg_MouseEnter" MouseLeave="EditSetImg_MouseLeave">
                <TextBlock Text="Edit Profile" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
            </Border>
            <!-- ID Number -->
            <StackPanel Margin="0,0,0,10" >
                <TextBlock Text="ID Number" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border CornerRadius="10" Background="White" Width="410" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/ID.png" Grid.Column="0" HorizontalAlignment="Left" Width="24" Height="24" Margin="10,0,5,0" />
                        <TextBlock x:Name="editIDtxt" Text="Enter ID Number" Style="{StaticResource textHint}"/>
                    </Grid>
                </Border>
            </StackPanel>
            <!-- Name -->
            <StackPanel >
                <TextBlock Text="Name" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border CornerRadius="10" Background="White" Width="410" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/equipmentBlue.png" Grid.Column="0" HorizontalAlignment="Left" Width="20" Height="24" Margin="10,0,5,0" />
                        <TextBlock x:Name="editNametxt" Text="Enter Name" Style="{StaticResource textHint}"/>
                        <TextBox x:Name="editNametext" TextChanged="editNametext_TextChanged" Style="{StaticResource textBox}"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="NameError" Foreground="Red" Margin="40,0,0,0"/>
            </StackPanel>
            <!-- Type -->
            <StackPanel>
                <TextBlock Text="Type" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border CornerRadius="10" Background="White" Width="410" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/typeBlue.png" Grid.Column="0" HorizontalAlignment="Left" Width="24" Height="24" Margin="10,0,5,0" />
                        <ComboBox x:Name="editTypetext" SelectionChanged="editTypetext_SelectionChanged" Grid.Column="1" BorderThickness="0" Background="Transparent" BorderBrush="Transparent" Margin="2,2,5,2" IsEditable="true" IsReadOnly="True" IsTextSearchEnabled="False" VerticalAlignment="Center">
                            <ComboBoxItem>Peripherals</ComboBoxItem>
                            <ComboBoxItem>Wirings</ComboBoxItem>
                            <ComboBoxItem>Audio/Visual</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                </Border>
                <TextBlock x:Name="TypeError" Foreground="Red" Margin="40,0,0,0"/>
            </StackPanel>
            <!-- Brand -->
            <StackPanel>
                <TextBlock Text="Brand" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border CornerRadius="10" Background="White" Width="410" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/brandBlue.png" Grid.Column="0" HorizontalAlignment="Left" Width="24" Height="24" Margin="10,0,5,0" />
                        <TextBlock x:Name="editBrandtxt" Text="Enter Brand" Style="{StaticResource textHint}"/>
                        <TextBox x:Name="editBrandtext" TextChanged="editBrandtext_TextChanged" Style="{StaticResource textBox}"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="BrandError" Foreground="Red" Margin="40,0,0,0"/>
            </StackPanel>
            <!-- Serial -->
            <StackPanel>
                <TextBlock Text="Serial Number" FontSize="12" FontFamily="Lato" FontWeight="Medium"  Foreground="Black" Background="{x:Null}"  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Border CornerRadius="10" Background="white" Width="410" Height="35" Margin="0,5,0,0" BorderBrush="LightGray" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/serialBlue.png" Grid.Column="0" HorizontalAlignment="Left" Width="24" Height="24" Margin="10,0,5,0" />
                        <TextBlock x:Name="editSerialtxt" Text="Enter Serial" Style="{StaticResource textHint}"/>
                        <TextBox x:Name="editSerialtext" TextChanged="editSerialtext_TextChanged" Style="{StaticResource textBox}"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="SerialError" Foreground="Red" Margin="40,0,0,0"/>
            </StackPanel>
            <!-- Cancel & Save Button -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Cancel Button -->
                <Border x:Name="Btn" CornerRadius="5" Background="White" Margin="0,0,10,0" MinWidth="60" MouseUp="Btn_MouseUp">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Cancel" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF5B5B5B" Margin="15,5,15,5"/>
                    </Grid>
                </Border>
                <!-- Save Button -->
                <Border x:Name="SaveBtn" CornerRadius="5" Background="#0FA9FF" Margin="0,0,10,0" MinWidth="60" MouseUp="SaveBtn_MouseUp" MouseEnter="SaveBtn_MouseEnter" MouseLeave="SaveBtn_MouseLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Img/editWhite.png" Grid.Column="0" Width="18" HorizontalAlignment="Center" Margin="5"/>
                        <TextBlock Grid.Column="1" Text="Save" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Margin="0,0,10,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </Canvas>
</Page>
