<Page x:Class="EQMS.Reservation.Reservation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EQMS.Reservation"
      mc:Ignorable="d" 
      d:DesignHeight="610" d:DesignWidth="1100"
      Title="Reservation">

    <!-- Center Panel -->
    <DockPanel LastChildFill="True">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Title and Search Box -->
            <DockPanel Grid.Row="0" LastChildFill="False">
                <TextBlock Text="Reservations" Foreground="#FF374957" FontSize="18" VerticalAlignment="Center" Margin="30,0,0,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border x:Name="AddReservation" CornerRadius="10" Background="White" MinWidth="100" Height="30" Margin="5,5,20,5" VerticalAlignment="Center" BorderBrush="LightGray" BorderThickness="1" MouseUp="AddReservation_MouseUp" MouseEnter="AddReservation_MouseEnter" MouseLeave="AddReservation_MouseLeave">
                        <TextBlock x:Name="AddReservationtxt" Text="Add Reservation" Margin="15,5,15,5" VerticalAlignment="Center" Foreground="#FF374957" FontWeight="Bold"/>
                    </Border>
                    <!-- Search Box -->
                    <Border Style="{StaticResource searchBox}" >
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="../Resources/Img/searchBlack.png" Grid.Column="1" HorizontalAlignment="Left" Width="24" Margin="10,0,5,0" />
                            <TextBlock x:Name="textSearch" Text="Search..." Style="{StaticResource searchHint}"/>
                            <TextBox x:Name="txtSearch" TextChanged="txtSearch_TextChanged" Style="{StaticResource  searchTextBox}"/>
                        </Grid>
                    </Border>
                </StackPanel>
                
            </DockPanel>

            <!-- Home Data Grid -->
            <DataGrid x:Name="ReservationsDataGrid" Style="{DynamicResource DataGridStyle1}" CellStyle="{DynamicResource DataGridCellStyle1}" ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}" RowStyle="{DynamicResource DataGridRowStyle1}" Grid.Row="1" MouseUp="ReservationsDataGrid_MouseUp">
                <DataGrid.Columns>
                    <!-- ID Number Column -->
                    <DataGridTextColumn Header="ID" Binding="{Binding ID}"  IsReadOnly="True" CanUserResize="False" Width="50"/>
                    <!-- Equipment Name Column -->
                    <DataGridTextColumn Header="Equipment Name" Binding="{Binding EquipmentName}" IsReadOnly="True" CanUserResize="False" Width="140"/>
                    <!-- Type Column -->
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}"  IsReadOnly="True" CanUserResize="False" Width="120"/>
                    <!-- Borrower Name Column -->
                    <DataGridTextColumn Header="Borrower Name" Binding="{Binding BorrowerName}" IsReadOnly="True" CanUserResize="False" Width="140"/>
                    <!-- Date Reserved Column -->
                    <DataGridTextColumn Header="Date Reserved" Binding="{Binding ReservationDate}"  IsReadOnly="True" CanUserResize="False" Width="*"/>
                    <!-- Borrowing Date Column -->
                    <DataGridTextColumn Header="Borrowing Date" Binding="{Binding StartDate}"  IsReadOnly="True" CanUserResize="False" Width="*"/>
                    <!-- Return Date Column -->
                    <DataGridTextColumn Header="Return Date" Binding="{Binding ReturnDate}"  IsReadOnly="True" CanUserResize="False" Width="*"/>
                    <!-- Status Column -->
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}"  IsReadOnly="True" CanUserResize="False" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Page>
